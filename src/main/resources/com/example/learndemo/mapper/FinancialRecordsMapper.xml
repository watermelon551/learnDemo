<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.learndemo.mapper.FinancialRecordsMapper">

    <resultMap id="BaseResultMap" type="com.example.learndemo.domain.FinancialRecords">
            <id property="id" column="id" />
            <result property="username" column="username" />
            <result property="type" column="type" />
            <result property="amount" column="amount" />
            <result property="operation" column="operation" />
            <result property="description" column="description" />
            <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,username,type,amount,operation,description,
        create_time
    </sql>

    <!-- 按日统计押金/租金/罚款收入 -->
    <select id="selectFinanceTrend" resultType="map">
        SELECT DATE_FORMAT(create_time, '%Y-%m-%d') AS day,
            SUM(CASE WHEN type = 'deposit' THEN amount ELSE 0 END) AS deposit,
            SUM(CASE WHEN type = 'rent' THEN amount ELSE 0 END) AS rent,
            SUM(CASE WHEN type = 'fine' THEN amount ELSE 0 END) AS fine
        FROM financial_records
        GROUP BY day
        ORDER BY day ASC
    </select>
</mapper>
